{
  "name": "bus-management-system-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "test:ci": "ng test --watch=false",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" playwright.config.ts",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@jsverse/transloco": "8.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11 <12"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.5"
  }
}
