# Local development only. Copy to the repository-root .env; never commit real credentials.
# Shared with Compose and the Spring local profile: use plain KEY=value entries,
# without shell export statements, quotes, backslash escapes or variable expansion.
POSTGRES_DB=bus_management
POSTGRES_USER=bus_management
POSTGRES_PASSWORD=local-development-only
# Both local modes publish PostgreSQL on loopback for DBeaver.
POSTGRES_PORT=5432

# Full stack: Caddy; host development: Keycloak. Bound only to loopback.
FRONTEND_PORT=8082

# Synthetic local-demo credentials only. Keep the realm off the public internet.
KEYCLOAK_DB_PASSWORD=local-keycloak-db-change-me
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-change-me
OIDC_CLIENT_SECRET=local-client-secret-change-me
DEMO_USER_PASSWORD=local-demo-password-change-me
